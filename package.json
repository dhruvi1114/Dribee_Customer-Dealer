{
  "name": "RNBoilerplate",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:local": "APP_ENV=local react-native run-android",
    "android:dev": "APP_ENV=development react-native run-android",
    "android:prod": "APP_ENV=production react-native run-android",
    "ios": "react-native run-ios",
    "ios:local": "APP_ENV=local react-native run-ios",
    "ios:dev": "APP_ENV=development react-native run-ios",
    "ios:prod": "APP_ENV=production react-native run-ios",
    "start": "react-native start",
    "start:local": "APP_ENV=local react-native start --reset-cache",
    "start:dev": "APP_ENV=development react-native start --reset-cache",
    "start:prod": "APP_ENV=production react-native start --reset-cache",
    "start:clean": "react-native start --reset-cache",
    "build": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "jest",
    "pods": "cd ios && pod install && cd ..",
    "postinstall": "patch-package",
    "generate-app-icon": "node scripts/generate-app-icon.js"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "5.2.8",
    "@hookform/resolvers": "^3.9.1",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-native-clipboard/clipboard": "1.16.3",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-firebase/analytics": "23.8.6",
    "@react-native-firebase/app": "23.8.6",
    "@react-native-firebase/crashlytics": "23.8.6",
    "@react-native-firebase/messaging": "23.8.6",
    "@react-navigation/bottom-tabs": "7.15.2",
    "@react-navigation/native": "7.1.31",
    "@react-navigation/native-stack": "7.14.2",
    "@reduxjs/toolkit": "2.11.2",
    "@tanstack/react-query": "5.90.21",
    "axios": "1.13.5",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "lucide-react-native": "0.575.0",
    "nativewind": "4.2.2",
    "react": "18.3.1",
    "react-hook-form": "7.71.2",
    "react-native": "0.76.5",
    "react-native-bootsplash": "7.1.0",
    "react-native-device-info": "15.0.2",
    "react-native-element-dropdown": "^2.12.4",
    "react-native-fast-image": "8.6.3",
    "react-native-gesture-handler": "2.30.0",
    "react-native-haptic-feedback": "2.3.3",
    "react-native-image-picker": "^8.2.1",
    "react-native-keyboard-aware-scroll-view": "0.9.5",
    "react-native-keychain": "10.0.0",
    "react-native-linear-gradient": "2.8.3",
    "react-native-mmkv": "^3.3.3",
    "react-native-permissions": "^5.5.1",
    "react-native-razorpay": "^3.0.0",
    "react-native-reanimated": "3.16.7",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.4.0",
    "react-native-svg": "^15.11.1",
    "react-native-toast-message": "2.3.3",
    "react-native-vector-icons": "10.3.0",
    "react-redux": "9.2.0",
    "redux-persist": "6.0.0",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "3.4.19",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native/babel-preset": "0.76.5",
    "@react-native/eslint-config": "0.76.5",
    "@react-native/metro-config": "0.76.5",
    "@react-native/typescript-config": "0.76.5",
    "@types/react": "^18.2.6",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-native-dotenv": "^3.4.11",
    "react-test-renderer": "18.3.1",
    "sharp": "^0.34.5",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
